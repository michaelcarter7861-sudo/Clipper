# ---------------------------------------------------------------------------
# Copy to .env and fill in what you have. In GitHub Actions, set these as
# repository secrets instead — .env is gitignored and never uploaded.
# ---------------------------------------------------------------------------

# --- LLM (pick ONE; all have free tiers) -----------------------------------
# Groq (fastest free tier, recommended): https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any other OpenAI-compatible endpoint (FreeLLMAPI router, LiteLLM, Ollama...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Optional model override
LLM_MODEL=
# auto | claude-code | api | heuristic
LLM_BACKEND=auto
# Model id reported to Claude Code (the bridge routes it upstream anyway)
CLAUDE_MODEL=claude-sonnet-4-5

# --- YouTube ---------------------------------------------------------------
# Needed when YouTube demands a sign-in ("confirm you're not a bot").
# Export cookies.txt from your browser with a "Get cookies.txt" extension.
YT_COOKIES=
# Extra yt-dlp flags, space separated, e.g. --proxy http://127.0.0.1:7890
YTDLP_EXTRA_ARGS=

# --- clipping --------------------------------------------------------------
CLIP_COUNT=3
CLIP_MIN_DURATION=18
CLIP_MAX_DURATION=60
CAPTION_STYLE=karaoke
CAPTION_HIGHLIGHT=#FFE100
CLIP_FIT=crop
WHISPER_MODEL=base
