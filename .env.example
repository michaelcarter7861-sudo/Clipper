# ---------------------------------------------------------------------------
# Copy to .env and fill in what you have. In GitHub Actions, set these as
# repository secrets instead — .env is gitignored and never uploaded.
# ---------------------------------------------------------------------------

# --- LLM (pick ONE; all have free tiers) -----------------------------------
# Groq (fastest free tier, recommended): https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any other OpenAI-compatible endpoint (FreeLLMAPI router, LiteLLM, Ollama...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Optional model override
LLM_MODEL=
# auto | claude-code | api | heuristic
LLM_BACKEND=auto
# Model id reported to Claude Code (the bridge routes it upstream anyway)
CLAUDE_MODEL=claude-sonnet-4-5

# --- YouTube ---------------------------------------------------------------
# Needed when YouTube demands a sign-in ("confirm you're not a bot").
# Export cookies.txt from your browser ("Get cookies.txt LOCALLY"), then check it:
#   python -m clipper.cookies --check cookies.txt --test
# Paste the raw text here, or its base64 form.
YT_COOKIES=
# Extra yt-dlp flags, space separated, e.g. --cookies-from-browser chrome
# (only the flags you set are applied — defaults never clobber the pipeline settings)
YTDLP_EXTRA_ARGS=
# Route yt-dlp through a proxy when YouTube throttles your IP (http://user:pass@host:port)
CLIP_PROXY=
# Highest source resolution to download
CLIP_MAX_VIDEO_HEIGHT=1080

# --- editing ---------------------------------------------------------------
# full | cuts | off
CLIP_EDITING=full
CLIP_TIGHTEN=true
CLIP_MAX_PAUSE=0.45
CLIP_REMOVE_FILLERS=false
CLIP_SPEED=1.0
CLIP_PUNCH_IN=1.04
CLIP_LOOK=clean
CLIP_PROGRESS_BAR=true
# corner handle, e.g. @yourchannel
CLIP_WATERMARK=

# --- clipping --------------------------------------------------------------
CLIP_COUNT=3
CLIP_MIN_DURATION=18
CLIP_MAX_DURATION=60
CAPTION_STYLE=karaoke
CAPTION_HIGHLIGHT=#FFE100
CLIP_FIT=crop
WHISPER_MODEL=base
